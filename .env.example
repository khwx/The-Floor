# Google Genkit / Gemini
# O plugin @genkit-ai/googleai aceita qualquer uma destas duas vars (usa a que tiveres)
GOOGLE_GENAI_API_KEY=your_genai_key_here
# GEMINI_API_KEY=your_genai_key_here  # alternativa

# Firebase Configuration (usado no multiplayer tempo-real)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Pixabay API (para imagens das perguntas)
PIXABAY_API_KEY=your_pixabay_key_here

# Supabase (opcional mas recomendado para Vercel - ver supabase/schema.sql)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# Apenas servidor - não expor com NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here